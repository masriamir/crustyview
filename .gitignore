# Shared ignores are block-synced from masriamir/.github (see .meta-manifest.toml,
# `just meta-check`). Edit the canonical source upstream, not inside the markers.
# >>> meta:gitignore-rust
# Compiled output / build artifacts
/target/
**/target/

# Backup files from rustfmt / editors
**/*.rs.bk
*.orig

# MSVC debug info (Windows)
*.pdb

# Coverage output (cargo-llvm-cov / grcov)
*.profraw
*.profdata
/lcov.info
/coverage/
# <<< meta:gitignore-rust

# >>> meta:gitignore-base
# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Environment / local overrides
.env
.env.local

# Python bytecode caches
__pycache__/
*.py[cod]

# Temporary files
/.tmp/

# Claude Code agent worktrees (ephemeral, created by Claude Code)
.claude/worktrees/

# Ad-hoc local git worktrees
.worktrees/

# AI agent artifacts (superpowers plans/specs — never committed)
docs/superpowers/

# Playwright MCP browser-session artifacts
.playwright-mcp/
# <<< meta:gitignore-base

# ─── crustyview-specific ─────────────────────────────────────────────────────

# wasm-bindgen build output (regenerated by the build; never committed)
crates/crustyview-web/web/pkg/
crates/crustyview-web/web/pkg-node/
web/src/wasm/

# local WAD blobs — never commit (the viewer reads them, never ships them)
*.wad
*.WAD

# web app — node_modules at any depth (a stray root-level npm/vitest run once
# created one and its cache got committed; PR #180 review caught it)
node_modules/
web/dist/

# playwright e2e
web/playwright-report/
web/test-results/
/.freedoom/

# vitest browser mode
web/.vitest-attachments/
web/src/**/__screenshots__/
